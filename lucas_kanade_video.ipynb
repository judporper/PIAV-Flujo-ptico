    "PASO = 20        # separación entre puntos de la rejilla\n",
    "ESCALA = 5       # para ver mejor las flechas\n",
    "\n",
    "def dibujar_flechas(frame, F, G, Fx, Fy):\n",
    "    salida = frame.copy()\n",
    "    alto, ancho = Fx.shape\n",
    "    for y in range(R, alto - R, PASO):\n",
    "        for x in range(R, ancho - R, PASO):\n",
    "            h = lk_punto_iter(F, G, Fx, Fy, x, y)\n",
    "            if h is None:\n",
    "                continue\n",
    "            fin = (int(x + ESCALA * h[0]), int(y + ESCALA * h[1]))\n",
    "            cv2.arrowedLine(salida, (x, y), fin, (0, 255, 0), 1)\n",
    "    return salida\n",
    "\n",
    "resultado = dibujar_flechas(frame_nue, F, G, Fx, Fy)\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "plt.imshow(cv2.cvtColor(resultado, cv2.COLOR_BGR2RGB))\n",
    "plt.title(\"Lucas-Kanade (iterativo) entre dos frames\")\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
