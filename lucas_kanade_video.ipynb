    "R = 7                    # radio de la ventana -> ventana de 15x15\n",
    "UMBRAL_DET = 1e4         # si el determinante es menor, no nos fiamos (valor a ojo, se puede cambiar)\n",
    "H_MAX = 20               # si h sale más grande que esto (en píxeles) tampoco nos fiamos\n",
    "\n",
    "def lk_punto(Fx, Fy, dif, x, y, r=R):\n",
    "    # ventana alrededor del punto\n",
    "    wx = Fx[y-r:y+r+1, x-r:x+r+1]\n",
    "    wy = Fy[y-r:y+r+1, x-r:x+r+1]\n",
    "    wd = dif[y-r:y+r+1, x-r:x+r+1]\n",
    "\n",
    "    # las cinco sumas del paper\n",
    "    sxx = np.sum(wx * wx)\n",
    "    syy = np.sum(wy * wy)\n",
    "    sxy = np.sum(wx * wy)\n",
    "    sxd = np.sum(wd * wx)\n",
    "    syd = np.sum(wd * wy)\n",
    "\n",
    "    A = np.array([[sxx, sxy],\n",
    "                  [sxy, syy]])\n",
    "    b = np.array([sxd, syd])\n",
    "\n",
    "    if np.linalg.det(A) < UMBRAL_DET:\n",
    "        return None\n",
    "\n",
    "    h = np.linalg.solve(A, b)      # h = A^-1 b\n",
    "    if np.linalg.norm(h) > H_MAX:\n",
    "        return None\n",
    "    return h                       # (hx, hy)"
   ]
