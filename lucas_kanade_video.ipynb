   "source": [
    "R = 7                    # radio de la ventana -> ventana de 15x15\n",
    "UMBRAL_DET = 1e4         # si el determinante es menor, no nos fiamos\n",
    "H_MAX = 20               # desplazamiento máximo permitido (en píxeles)\n",
    "MAX_ITER = 10            # número máximo de iteraciones\n",
    "EPS = 0.01               # si la corrección es menor que esto, paramos\n",
    "\n",
    "def lk_punto_iter(F, G, Fx, Fy, x, y, r=R, max_iter=MAX_ITER, eps=EPS):\n",
    "    alto, ancho = F.shape\n",
    "    tam = 2 * r + 1\n",
    "\n",
    "    # ventana fija en la imagen anterior G\n",
    "    wg = G[y-r:y+r+1, x-r:x+r+1]\n",
    "\n",
    "    h = np.array([0.0, 0.0], dtype=np.float32)\n",
    "\n",
    "    for _ in range(max_iter):\n",
    "        cx = float(x + h[0])\n",
    "        cy = float(y + h[1])\n",
    "\n",
    "        # comprobar que la ventana desplazada no se sale de la imagen\n",
    "        if cx < r or cx >= ancho - r or cy < r or cy >= alto - r:\n",
    "            return None\n",
    "\n",
    "        # mover la ventana sobre F, Fx y Fy según el h actual (interpolación subpíxel)\n",
    "        wf = cv2.getRectSubPix(F,  (tam, tam), (cx, cy))\n",
    "        wx = cv2.getRectSubPix(Fx, (tam, tam), (cx, cy))\n",
    "        wy = cv2.getRectSubPix(Fy, (tam, tam), (cx, cy))\n",
    "        wd = wg - wf                                 # G(x) - F(x + h)\n",
    "\n",
    "        # las cinco sumas del paper\n",
    "        sxx = np.sum(wx * wx)\n",
    "        syy = np.sum(wy * wy)\n",
    "        sxy = np.sum(wx * wy)\n",
    "        sxd = np.sum(wd * wx)\n",
    "        syd = np.sum(wd * wy)\n",
    "\n",
    "        A = np.array([[sxx, sxy],\n",
    "                      [sxy, syy]])\n",
    "        b = np.array([sxd, syd])\n",
    "\n",
    "        if np.linalg.det(A) < UMBRAL_DET:\n",
    "            return None\n",
    "\n",
    "        dh = np.linalg.solve(A, b)                   # corrección Δh = A^-1 b\n",
    "        h = h + dh                                   # actualizamos h\n",
    "\n",
    "        if np.linalg.norm(h) > H_MAX:\n",
    "            return None\n",
    "        if np.linalg.norm(dh) < eps:                 # ya ha convergido\n",
    "            break\n",
    "\n",
    "    return h                                         # (hx, hy)"
   ]
